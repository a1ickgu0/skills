{
  "metadata": {
    "source": "Teece, D.J. (1986) 'Profiting from Technological Innovation', Research Policy 15, 285-305",
    "version": "1.0",
    "usage_rules": [
      "独占性制度：统一使用'独占性'（强/弱），不使用'专有性''占有性'",
      "互补资产三分类：通用型 / 专用型 / 共用型，不使用'共专用''共同专有'",
      "共用型而非共专用：强调双向依赖关系（bilateral dependence），避免'共专用'的歧义",
      "三阶段模型：前范式阶段 → 范式阶段 → 后续阶段（组织内显式化命名）",
      "整合 vs 契约：整合=通过所有权控制；契约=通过合同关系获取；不使用'一体化'",
      "创新者定义：特指率先将新产品/工艺商业化的企业（first to commercialize），非仅发明者"
    ]
  },
  "terms": {
    "core_concepts": [
      {
        "id": "pfi",
        "en": "Profiting from Technological Innovation",
        "zh": "从技术创新中获利",
        "alt_zh": ["技术创收"],
        "note": "论文标题"
      },
      {
        "id": "appropriability_regime",
        "en": "Regime of Appropriability",
        "zh": "独占性制度",
        "alt_zh": ["专有性体制", "占有性机制", "独占性机制"],
        "note": "'制度'强调外部环境制度属性，非企业内部能力"
      },
      {
        "id": "tight_appropriability",
        "en": "Tight Appropriability Regime",
        "zh": "强独占性",
        "alt_zh": ["紧独占性", "强专有性"],
        "note": "技术难模仿 + 法律保护有效"
      },
      {
        "id": "weak_appropriability",
        "en": "Weak Appropriability Regime",
        "zh": "弱独占性",
        "alt_zh": ["弱专有性", "松独占性"],
        "note": "技术透明 + 法律保护薄弱；论文指出弱独占性是常态"
      },
      {
        "id": "complementary_assets",
        "en": "Complementary Assets",
        "zh": "互补资产",
        "alt_zh": ["互补性资产", "辅助资产"],
        "note": "论文最核心概念"
      },
      {
        "id": "generic_assets",
        "en": "Generic Assets",
        "zh": "通用资产/通用型资产",
        "alt_zh": ["一般性资产", "通用型互补资产"],
        "note": "无需为创新量身定制，市场随处可获"
      },
      {
        "id": "specialized_assets",
        "en": "Specialized Assets",
        "zh": "专用资产/专用型资产",
        "alt_zh": ["专业化资产", "特有资产"],
        "note": "创新与资产间存在单向依赖"
      },
      {
        "id": "cospecialized_assets",
        "en": "Cospecialized Assets",
        "zh": "共用型资产/共用/双向专用资产",
        "alt_zh": ["共专用资产", "共同专有资产", "互专用资产"],
        "note": "创新与资产间存在双向依赖；利润关键所在"
      },
      {
        "id": "dominant_design",
        "en": "Dominant Design",
        "zh": "主导设计",
        "alt_zh": ["主导设计范式", "优势设计"],
        "note": "行业技术标准的确立"
      },
      {
